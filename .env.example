# RASD 360 — copier en .env pour surcharger les valeurs par défaut (backend/app/config.py)
RASD_OLLAMA_URL=http://127.0.0.1:11434
# Modèle par défaut (rapide, 8 Go de VRAM) ; qwen3.5:9b pour la qualité
RASD_LLM_MODEL=qwen3:8b
RASD_LLM_MODEL_QUALITY=qwen3.5:9b
# Embeddings des questions : sentence_transformers (CPU, recommandé) ou ollama
RASD_EMBED_BACKEND=sentence_transformers
RASD_EMBED_DEVICE=cpu
# Seuil d'abstention du retriever (calibré, voir scripts/calibrate_retriever.py)
# RASD_ABSTAIN_THRESHOLD=0.48
# URL de l'API vue par le frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
